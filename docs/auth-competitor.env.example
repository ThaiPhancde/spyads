# Merge these keys into the existing root .env. Keep the current DATABASE_URL and connector secrets.
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Local HTTP only. Set 1 with APP_URL=https://your-domain for a public deployment.
AUTH_COOKIE_SECURE=0
AUTH_SESSION_HOURS=168

# API and the existing standalone worker must not both run the old scheduler.
DISABLE_SCHEDULER=1
COMPETITOR_CONCURRENCY=1
COMPETITOR_TIMEOUT_SECONDS=180
COMPETITOR_MAX_ADS=200
COMPETITOR_MAX_PAGES=10
COMPETITOR_SCANS_PER_SOURCE_HOUR=10
# Optional per-source overrides (scan attempts/hour, shared across worker processes):
COMPETITOR_QUOTA_META_LIBRARY=10
COMPETITOR_QUOTA_META_GRAPH=10
COMPETITOR_QUOTA_TIKTOK_AD_LIBRARY=10

# Optional password reset email. Without SMTP, requests appear in ADMIN and links are issued by CLI.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=toolspy@example.com
SMTP_USER=
SMTP_PASSWORD=
