# ToolSpy — mẫu biến môi trường cho phần AI / LLM (copy sang .env rồi điền key thật; .env đã nằm trong .gitignore).
# Các phần khác (DATABASE_URL, ADMIN_TOKEN, R2_*, …) xem docs/DATA_SOURCES_AND_DEPLOY.md.
# Hướng dẫn đăng ký từng key: docs/LLM_FREE_PROVIDERS.md. Mọi provider dưới đây đều có gói miễn phí; không có key nào thì app
# vẫn chạy bằng quy tắc (rule-based). Không có provider trả phí nào được gọi.

# --- Văn bản (đặt tên sản phẩm, hiểu từ khoá, AI Agent, giải thích điểm, comment) ---
CEREBRAS_API_KEY=            # https://cloud.cerebras.ai — gpt-oss-120b, 1M token/ngày miễn phí
GROQ_API_KEY=                # https://console.groq.com/keys — gpt-oss-120b + gpt-oss-20b (mỗi model 200k token/ngày), qwen vision, Whisper
# Thứ tự thử (provider[:model]); để trống = mặc định dưới đây
LLM_PROVIDERS=cerebras,cerebras:qwen-3.8-27b,groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,cloudflare,gemini
# CEREBRAS_MODEL=gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b   # chỉ dùng cho mục "groq" không kèm model
# LLM_REASONING_EFFORT=low

# --- Ảnh (OCR thumbnail) và lời nói trong video ---
VISION_PROVIDERS=groq:qwen/qwen3.8-27b,cerebras:qwen-3.8-27b,gemini
TRANSCRIBE_PROVIDERS=groq:whisper-large-v3-turbo,gemini
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   # OCR cục bộ dự phòng (không tốn quota)

# --- Dự phòng ---
CLOUDFLARE_ACCOUNT_ID=       # cùng account với R2 (R2_ACCOUNT_ID cũng được dùng nếu để trống)
CLOUDFLARE_API_TOKEN=        # token có quyền "Workers AI" — 10.000 neurons/ngày miễn phí
# CF_AI_MODEL=@cf/openai/gpt-oss-20b
# CF_AI_DAILY_NEURONS=9500
GEMINI_API_KEY=              # https://aistudio.google.com/apikey — quota miễn phí nhỏ, dùng sau cùng
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_DAILY=20             # tổng số lần gọi Gemini/ngày cho mọi chức năng

# --- Hạn mức nội bộ mỗi ngày (đếm trong bảng external_api_calls, khởi động lại không bị reset) ---
# QUERY_LLM_DAILY=200         # từ khoá mới cần model (mỗi từ khoá chỉ hỏi 1 lần)
# CREATIVE_LLM_DAILY=300      # OCR + trích lời
# NAMING_LLM_DAILY=12         # dịch tên sang tiếng Việt (chạy tay)
# NAMING_AI_BATCHES_PER_TICK=2
# DISABLE_LLM=1               # tắt mọi lần gọi model
